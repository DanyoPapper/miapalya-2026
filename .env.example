# Adatbázis (Railway automatikusan beállítja)
DATABASE_URL=postgresql://user:password@localhost:5432/miapálya

# JWT titkos kulcs — min. 32 véletlenszerű karakter, SOHA ne commitold!
JWT_SECRET=generate-a-long-random-string-here-minimum-32-chars

# QR token titkos kulcs — szintén véletlenszerű, szerver oldali titok
TOKEN_SECRET=another-long-random-string-for-qr-tokens

# Frontend URL (CORS-hoz)
FRONTEND_URL=https://miapálya.pages.dev

# Alkalmazás
PORT=3000
NODE_ENV=production
EVENT_DATE=2026-10-15
